# 可选：复制为 .env；推荐在网页“设置 → 模型连接”配置账户。
# 新论文统一 AI 直读，模型须支持原 PDF 或页面图像输入。
# 密钥、论文和本机运行数据不得提交至 GitHub。
LLM_API_KEY=replace_with_your_key
LLM_BASE_URL=https://api.deepseek.com
LLM_PROTOCOL=openai
LLM_REQUIRES_KEY=true
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=2
LLM_MAX_REQUESTS=500
LLM_MAX_INPUT_CHARS=18000
LLM_REASONING_EFFORT=low
PAPERLENS_MAX_PAGES=300
PAPERLENS_MAX_UPLOAD_MB=100
PAPERLENS_PREVIEW_PAGES=40
PAPERLENS_BROWSER_CHANNEL=chrome
PAPERLENS_OUTPUT_DIR=outputs
PAPERLENS_CACHE_DIR=.cache/paperlens
LLM_MAX_OUTPUT_TOKENS=48000
PAPERLENS_MAX_PARALLEL_JOBS=1
PAPERLENS_JOB_HISTORY_LIMIT=30
PAPERLENS_READING_OUTPUT_TOKENS=8000
PAPERLENS_VISION_MODEL=
PAPERLENS_VISION_ALLOW_UNVERIFIED=false
PAPERLENS_MATH_ENABLED=true
PAPERLENS_REFERENCE_NETWORK=true
PAPERLENS_CHAT_MAX_REQUESTS=8
PAPERLENS_AUTO_TRANSLATE_ENABLED=false
PAPERLENS_AUTO_NOTES_ENABLED=false
PAPERLENS_AUTO_NOTES_MAX_PARAGRAPHS=6
PAPERLENS_AUTO_NOTES_CONTEXT=section
PAPERLENS_AUTO_NOTES_SUMMARY=true
PAPERLENS_AUTO_NOTES_EXPLAIN=true
PAPERLENS_AUTO_NOTES_CONNECTIONS=false
PAPERLENS_AUTO_NOTES_QUESTIONS=false
PAPERLENS_AUTO_NOTES_CHECK=false
PAPERLENS_CATALOG_NETWORK=false
PAPERLENS_CATALOG_AUTO_UPDATE=false
PAPERLENS_CATALOG_MAX_AGE_HOURS=168
PAPERLENS_TEXT_REVIEW_ENABLED=true

# 思考强度决定请求内的推理预算；max 往往显著增加耗时和成本。
# REQUESTS 包含重试；INPUT_CHARS 是单次文本预算，超限可按任务临时申请。
# 三档都读取全文，档位只调整分析深度和公式审校批次（1/2/4）。
# VISION_MODEL 留空沿用主模型；自定义模型需确认其图片能力。
# 自动翻译和自动笔记默认关闭，可在阅读时按需生成。
