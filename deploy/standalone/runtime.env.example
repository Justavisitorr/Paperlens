# Copy outside the repository, for example /srv/paperlens/standalone.env.
PAPERLENS_MAX_USERS=100
PAPERLENS_PROCESSING_SLOTS=2
# Set ONLY the observed Docker gateway/proxy IP; never '*'.
PAPERLENS_TRUSTED_PROXIES=REPLACE_WITH_ACTUAL_REVERSE_PROXY_IP

# Enable email after the provider has approved the sending address/domain.
PAPERLENS_SMTP_HOST=
PAPERLENS_SMTP_PORT=465
PAPERLENS_SMTP_STARTTLS=false
PAPERLENS_SMTP_USER=
PAPERLENS_SMTP_FROM=
# Create this file only when configuring SMTP. Leave unset before then.
# PAPERLENS_SMTP_PASSWORD_FILE=/run/paperlens-secrets/smtp-password

# Optional GitHub login; the pair must be set together.
PAPERLENS_GITHUB_CLIENT_ID=
# PAPERLENS_GITHUB_CLIENT_SECRET_FILE=/run/paperlens-secrets/github-secret

# Extra model endpoints must be exact, administrator-approved HTTPS base URLs.
# Users supply their own model API keys in the app. No LLM_API_KEY belongs here.
PAPERLENS_ALLOWED_MODEL_URLS=
